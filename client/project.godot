; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (see /docs/ARCHITECTURE.md and /tools/godot).

config_version=5

[application]

config/name="Project Fairway Frenzy"
config/description="Real-time multiplayer stickman golf racing."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/max_fps=0
boot_splash/bg_color=Color(0.105882, 0.12549, 0.231373, 1)
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Backend="*res://scripts/autoload/backend.gd"
Router="*res://scripts/autoload/router.gd"
Net="*res://scripts/net/net.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inference_on_variant=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.105882, 0.12549, 0.231373, 1)
