{
  "name": "fairway-frenzy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend service for Project Fairway Frenzy (auth, profiles, matchmaking, rooms, game server registry, match results).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "migrate": "node src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
